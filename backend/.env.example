# Copy to .env for local development. On Render, set these under
# Service → Environment instead (the .env file is not deployed).

# MongoDB Atlas → Connect → Drivers → copy the mongodb+srv:// string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/aicv?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Google AI Studio → Get API key (free tier works)
GEMINI_API_KEY=
# Optional: force a model order, e.g. gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_MODELS=

# Optional: comma-separated allowed frontend origins
# CLIENT_URLS=https://aicvfrontend.netlify.app,http://localhost:5173

# Optional
# MAX_RESUMES_PER_USER=10
# PORT=5000
